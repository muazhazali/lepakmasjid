# Use a local PocketBase instance for development. Maintainers may provide a
# separate development URL; never use production credentials in this file.
VITE_POCKETBASE_URL=http://127.0.0.1:8090
VITE_APP_URL=http://localhost:8080

# Optional: only needed by `pnpm seed:pocketbase`.
# POCKETBASE_ADMIN_EMAIL=
# POCKETBASE_ADMIN_PASSWORD=
# POCKETBASE_SEED_CREATED_BY=
# Optional: create a verified application admin for testing admin pages.
# These are not PocketBase superuser credentials.
# POCKETBASE_SEED_USER_EMAIL=admin@lepakmasjid.local
# POCKETBASE_SEED_USER_PASSWORD=
