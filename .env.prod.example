# Copy to .env.prod and fill in before: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Public URL users open in the browser (Cloudflare Tunnel hostname)
APP_URL=https://lepakmasjid.example.com

# Host port for the app (Cloudflare Tunnel → http://127.0.0.1:APP_PORT)
APP_PORT=8080

POSTGRES_USER=lepakmasjid
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=lepakmasjid

# openssl rand -hex 32
JWT_SECRET=change-me-long-random

# Set to 1 on first deploy only (creates admin from SEED_*), then set back to 0
RUN_SEED=0
SEED_ADMIN_EMAIL=admin@lepakmasjid.local
SEED_ADMIN_PASSWORD=change-me-after-first-login